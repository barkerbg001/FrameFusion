# FrameFusion ignore rules. This is the only .gitignore in the repository.
# Paths starting with "/" are anchored to the repo root; others match anywhere.

# --- Secrets and local configuration ---------------------------------------------------
# Real environment files hold Django/encryption secrets and must never be committed.
.env
.env.*
!.env.example
*.local
local_settings.py
# Exports of browser chats from the pre-Django UI may contain private conversations.
legacy-chats*.json
# Private keys, certificates and secret-scanner reports.
*.pem
*.key
*.p12
*.pfx
gitleaks-report*.json

# --- Python -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
/api/build/
/api/dist/
pip-log.txt
pip-delete-this-directory.txt
__pypackages__/

# Virtual environments
.venv/
venv/
env/
ENV/

# Tool caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.pyre/
.cache/

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
/web/coverage/

# --- Django runtime state ---------------------------------------------------------------
# SQLite database (+ WAL/SHM/journal files and timestamped backups), uploads and
# collected static files all live under api/var/ by default.
/api/var/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
db.sqlite3

# Rendered videos, audio and images, plus the Pexels download cache.
/api/generated/
/api/uploads/
/api/media/

# Temporary frames written by the video pipeline into its working directory.
/api/*_temp.jpg
/api/*_temp.jpeg
/api/*_temp.png
/api/resized_temp.jpg
/api/*.mp4
/api/*.mp3
/api/*.wav
/api/*.avi

# --- Frontend ---------------------------------------------------------------------------
node_modules/
/web/dist/
/web/dist-ssr/
*.tsbuildinfo
.vite/

# --- Logs -------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors and operating systems ------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
