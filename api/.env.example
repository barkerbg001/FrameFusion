# FrameFusion API configuration. Copy to api/.env (`npm run setup` does this and
# generates the two secrets below). Never commit api/.env.

# --- Required -------------------------------------------------------------------------------
# Django signing secret (CSRF). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Fernet key that encrypts saved API keys (AI providers, ElevenLabs, Pexels) at rest. Keep it
# out of the database directory and back it up separately: losing it makes saved keys
# unreadable (re-enter them in Settings). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first and keep the old one after a comma until keys are re-saved.
FRAMEFUSION_ENCRYPTION_KEY=

# --- Server ---------------------------------------------------------------------------------
# FrameFusion has no login. It is meant to run on your own machine and only accepts
# localhost hosts and origins unless FRAMEFUSION_ALLOW_REMOTE=true. See SECURITY.md before
# changing any of these.
# true only for local development (detailed errors).
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Browser origins allowed to call the API (CORS + CSRF).
FRAMEFUSION_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Address `npm run dev:api` binds to. Non-loopback addresses need FRAMEFUSION_ALLOW_REMOTE.
# FRAMEFUSION_HOST=127.0.0.1
# FRAMEFUSION_PORT=8000
# Only set true if the server sits behind your own authentication (VPN, reverse-proxy login).
# FRAMEFUSION_ALLOW_REMOTE=false
# Defaults to the opposite of DJANGO_DEBUG. Set true whenever the site is served over HTTPS.
# DJANGO_SECURE_COOKIES=false

# --- Storage (relative paths are resolved from api/) ----------------------------------------
FRAMEFUSION_DB_PATH=var/framefusion.sqlite3
FRAMEFUSION_UPLOAD_DIR=var/uploads
FRAMEFUSION_OUTPUT_DIR=generated
# FRAMEFUSION_STATIC_ROOT=var/static
FRAMEFUSION_MAX_UPLOAD_MB=200

# --- Background jobs and AI calls -----------------------------------------------------------
FRAMEFUSION_JOB_WORKERS=2
FRAMEFUSION_LLM_TIMEOUT_SECONDS=120
FRAMEFUSION_LLM_MAX_RETRIES=2
FRAMEFUSION_DISCOVERY_TIMEOUT_SECONDS=20
# Model lists offered when live model discovery is unavailable (comma-separated ids).
# FRAMEFUSION_OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4.5,google/gemini-2.5-flash
# FRAMEFUSION_GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-pro-latest
# FRAMEFUSION_ANTHROPIC_FALLBACK_MODELS=claude-sonnet-4-5,claude-haiku-4-5

# API keys are NOT configured here. Save them in the app (onboarding or Settings); they are
# encrypted with FRAMEFUSION_ENCRYPTION_KEY. If an older api/.env still has
# OPENROUTER_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY / ELEVENLABS_API_KEY /
# PEXELS_API_KEY / ELEVENLABS_VOICE_ID, import them once with
#   npm run manage -- import_env_keys
# and then delete those lines.
